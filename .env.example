# --- Database (TiDB Cloud, MySQL protocol) ---
DATABASE_URL="mysql://USER:PASSWORD@HOST:4000/webeside?sslaccept=strict&connection_limit=5"

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Auth ---
# Change this before deploying. Generate with: openssl rand -base64 48
AUTH_SECRET=""

# --- Seed admin (used once by `npm run db:seed`) ---
SEED_ADMIN_EMAIL="you@example.com"
SEED_ADMIN_PASSWORD=""

# --- Outbound email for enquiry notifications (optional) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Webeside Technology <you@example.com>"
ENQUIRY_NOTIFY_TO=""
